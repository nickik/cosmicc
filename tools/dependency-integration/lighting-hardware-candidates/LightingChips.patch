+package TbLightingMulDiv;
+import RegFile::*;
+import LightingMulDiv::*;
+module mkTbLightingMulDiv(Empty);
+ LightingMulDiv dut <- mkLightingMulDiv;
+ RegFile#(Bit#(12),Bit#(32)) vectors <- mkRegFileLoad("muldiv.hex",0,4095);
+ Reg#(Bit#(12)) offset <- mkReg(1);
+ Reg#(Bit#(32)) completed <- mkReg(0);
+ Reg#(Bool) waiting <- mkReg(False);
+ Reg#(Bit#(6)) latency <- mkReg(0);
+ Reg#(Bit#(3)) hold <- mkReg(0);
+ Reg#(Bit#(32)) cycles <- mkReg(0);
+ rule timeout;cycles<=cycles+1;if(cycles==50000)begin $display("FAIL muldiv timeout");$finish(1);end endrule
+ rule start(!waiting && dut.canStart);
+  dut.start(truncate(vectors.sub(offset)),vectors.sub(offset+1),vectors.sub(offset+2));waiting<=True;latency<=0;hold<=0;
+ endrule
+ rule waitResult(waiting && !dut.responseValid);latency<=latency+1;endrule
+ rule check(waiting && dut.responseValid);
+  Bool expectedFault=vectors.sub(offset+4)!=0;
+  if(dut.arithmeticFault!=expectedFault || (!expectedFault && dut.result!=vectors.sub(offset+3)) || (!expectedFault && latency!=32) || dut.canStart)begin
+   $display("FAIL muldiv vector=%0d result=%08x expected=%08x fault=%0d expected=%0d latency=%0d",completed,dut.result,vectors.sub(offset+3),dut.arithmeticFault,expectedFault,latency);$finish(1);
+  end
+  if(hold==5)begin
+   dut.consumeResponse;waiting<=False;offset<=offset+5;completed<=completed+1;
+   if(completed+1==vectors.sub(0))begin $display("PASS iterative muldiv %0d vectors and held responses",completed+1);$finish(0);end
+  end
+  else hold<=hold+1;
+ endrule
+endmodule
+endpackage
