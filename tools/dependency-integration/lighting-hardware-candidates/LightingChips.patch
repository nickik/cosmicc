@@ -0,0 +1,18 @@
+"""Build deterministic arithmetic vectors shared with the CPU differential corpus."""
+import importlib.util
+from pathlib import Path
+import sys
+
+def prepare(build):
+    source=Path(__file__).resolve().parents[1]/"translation-diff"
+    sys.path.insert(0,str(source))
+    spec=importlib.util.spec_from_file_location("lighting_cpu_vectors",source/"cpu_run.py")
+    module=importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    vectors=list(module.muldiv_vectors())
+    words=[len(vectors)]
+    for op,a,b,rd,rs,name in vectors:
+        result,fault=module.muldiv_expected(op,a,b)
+        words.extend([op,a&0xffffffff,b&0xffffffff,result,int(fault)])
+    words.extend([0]*(4096-len(words)))
+    (build/"muldiv.hex").write_text("".join(f"{word:08x}\n" for word in words))
diff --git a/tests/privilege-diff/run.py b/tests/privilege-diff/run.py
new file mode 100644
index 0000000..92cf1df
--- /dev/null
+++ b/tests/privilege-diff/run.py
@@ -0,0 +1,276 @@
+#!/usr/bin/env python3
+"""Compare real SIA32-P Rust execution with RTL, including privileged state."""
+from __future__ import annotations
+
+import argparse
+from dataclasses import dataclass
+import hashlib
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+
+ROOT = Path(__file__).resolve().parents[2]
+VECTOR = 0x100
+NOP = 0xCFFF
+
+
+def li(reg: int, value: int) -> int:
+    assert -64 <= value <= 63
+    return 0x6000 | reg << 7 | (value & 127)
+
+
+def swrite(reg: int, selector: int) -> int:
+    return 0xF100 | reg << 4 | selector
+
+
+@dataclass
+class Scenario:
+    name: str
+    words: dict[int, int]
+    stop: int
+    reset: int = 0
+    vector: int = VECTOR
+    irq: bool = False
+    expected_cause: int | None = None
+    fatal: bool = False
+
+
+def words_at(words: list[int], base: int = 0) -> dict[int, int]:
+    return {base + 2 * i: word for i, word in enumerate(words)}
+
+
+def corpus() -> list[Scenario]:
+    cases = []
+
+    def trap_case(name, program, *, user=False, cause=0):
+        words = words_at(program)
+        words[VECTOR] = NOP
+        reset = 0
+        if user:
+            # Architectural bootstrap: no test-only privilege setter in RTL.
+            words.update(words_at([li(1, 0), swrite(1, 1), swrite(1, 0), 0xF300], 0x80))
+            reset = 0x80
+        cases.append(Scenario(name, words, VECTOR, reset=reset, expected_cause=cause))
+
+    # Exhaust all system-register selectors in both modes. Defined forms in U
+    # must raise PRIVILEGE before validating a selector or write restriction.
+    for user in (False, True):
+        mode = "u" if user else "s"
+        for op in (0, 1, 2):
+            for selector in range(16):
+                insn = 0xF000 | op << 8 | 2 << 4 | selector
+                legal = (op == 0 and selector < 6) or (op == 1 and selector in (0, 1, 4, 5)) or (op == 2 and selector == 4)
+                if not user and legal:
+                    program = [li(2, 37), insn, NOP]
+                    cases.append(Scenario(f"{mode}-system-{op}-{selector}", words_at(program), 4))
+                else:
+                    trap_case(f"{mode}-system-{op}-{selector}", [li(2, 37), insn, li(3, 59)], user=user, cause=1 if user else 0)
+
+    # Structurally reserved words remain ILLEGAL, including in User mode.
+    for insn in (0xF310, 0xF320, 0xF410, 0xF403, 0xF510, 0xF501, 0xF610, 0xF601, 0xF710, 0xF701, 0xF800, 0xFFFF):
+        for user in (False, True):
+            trap_case(f"reserved-{insn:04x}-{'u' if user else 's'}", [insn, li(3, 59)], user=user)
+
+    for user in (False, True):
+        for insn in (0xF300, 0xF321, 0xF400, 0xF421, 0xF422, 0xF500):
+            if user:
+                trap_case(f"user-privileged-{insn:04x}", [insn], user=True, cause=1)
+        for imm in (0, 1, 0x5A, 253):
+            trap_case(f"trap-{imm}-{'u' if user else 's'}", [0xC00F | imm << 4], user=user, cause=3 | imm << 8)
+        trap_case(f"break-{'u' if user else 's'}", [0xCFEF], user=user, cause=2)
+        for insn in (0xF600, 0xF700):
+            words = words_at([insn, NOP])
+            reset = 0
+            if user:
+                words.update(words_at([swrite(0, 1), swrite(0, 0), 0xF300], 0x80))
+                reset = 0x80
+            cases.append(Scenario(f"unprivileged-{insn:04x}-{user}", words, 2, reset=reset))
+
+    for status in range(8):
+        trap_case(f"supervisor-trap-status-{status}", [li(1, status), swrite(1, 0), 0xC5AF], cause=0x5A03)
+    for status in (0, 2):
+        words = words_at([0xC5AF])
+        words[VECTOR] = NOP
+        words.update(words_at([swrite(0, 1), li(1, status), swrite(1, 0), 0xF300], 0x80))
+        cases.append(Scenario(f"user-trap-ie-{status >> 1}", words, VECTOR, reset=0x80, expected_cause=0x5A03))
+
+    # STATUS reserved bits, R0 destinations/sources, SCRATCH swap and VMCTX.
+    program = [li(1, -9), swrite(1, 0), 0xF020, li(1, 23), swrite(1, 4),
+               0xF004, 0xF204, 0xF034, 0xF205, NOP]
+    # Final SSWAP VMCTX is deliberately illegal; BADADDR must stay unchanged.
+    trap_case("status-mask-and-r0", program)
+    cases.append(Scenario("scratch-swap-r0", words_at([li(1, 31), swrite(1, 4), li(2, -7), 0xF224, 0xF204, 0xF034, NOP]), 12))
+    cases.append(Scenario("vmctx-and-fences", words_at([li(1, -1), swrite(1, 5), 0xF025, 0xF400, 0xF411, 0xF412, 0xF035, NOP]), 14))
+    cases.append(Scenario("wfi-terminal", words_at([0xF500]), 0))
+
+    for status in (0, 2, 4, 6):
+        for ctx in (False, True):
+            program = [li(1, 32), swrite(1, 1), li(1, status), swrite(1, 0), li(2, 45), 0xF321 if ctx else 0xF300]
+            words = words_at(program)
+            words[32] = NOP
+            cases.append(Scenario(f"return-{status}-ctx-{ctx}", words, 32))
+    for ctx in (False, True):
+        trap_case(f"odd-return-ctx-{ctx}", [li(1, 9), swrite(1, 5), li(1, 3), swrite(1, 1), li(2, 45), 0xF321 if ctx else 0xF300], cause=4)
+
+    # Faulting destinations and younger instructions must not commit.
+    trap_case("odd-jalr", [li(1, 3), 0xC210, li(3, 59)], cause=4)
+    trap_case("load-align", [li(1, 3), 0x7214, li(3, 59)], cause=6)
+    trap_case("store-align", [li(1, 3), 0x7217, li(3, 59)], cause=8)
+    trap_case("load-access", [li(1, -4), 0x7214, li(3, 59)], cause=11)
+    trap_case("store-access", [li(1, -4), 0x7217, li(3, 59)], cause=12)
+    trap_case("checked-overflow", [li(1, -1), 0x5118, li(2, 1), 0x4121, li(3, 59)], cause=13)
+    cases.append(Scenario("fetch-access", {VECTOR: NOP}, VECTOR, reset=4096, expected_cause=10))
+    cases.append(Scenario("fetch-align", {VECTOR: NOP}, VECTOR, reset=3, expected_cause=4))
+
+    # Handler advances EPC and SRET resumes the first nonfaulting instruction.
+    words = words_at([0xC5AF, li(3, 59), NOP])
+    words.update(words_at([0xF011, 0x6882, swrite(1, 1), 0xF300], VECTOR))
+    cases.append(Scenario("trap-handler-return", words, 4, expected_cause=0x5A03))
+
+    # A load-alignment fault sets BADADDR; a later TRAP must preserve it.
+    words = words_at([li(1, 3), 0x7214, 0xC00F, NOP])
+    words.update(words_at([0xF021, 0x6902, swrite(2, 1), 0xF300], VECTOR))
+    cases.append(Scenario("badaddr-preserved-by-trap", words, 6, expected_cause=3))
+
+    words = words_at([li(1, 1), swrite(1, 0), li(3, 59)])
+    words.update(words_at([0xF022, 0xF031, NOP], VECTOR))
+    cases.append(Scenario("interrupt-after-ie-enable", words, VECTOR + 4, irq=True, expected_cause=0x80000001))
+    words = words_at([li(4, 2), swrite(0, 1), li(1, 2), swrite(1, 0), 0xF300])
+    words.update(words_at([0x6981, 0xAA01, NOP, 0xF300], VECTOR))
+    cases.append(Scenario("held-interrupt-reenters-after-sret", words, VECTOR + 4, irq=True, expected_cause=0x80000001))
+    trap_case("synchronous-before-masked-interrupt", [0xC5AF, li(3, 59)], cause=0x5A03)
+    cases[-1].irq = True
+
+    for origin, program, irq, cause in (
+        ("trap", [li(1, 29), swrite(1, 4), swrite(1, 5), 0xC5AF], False, 0x5A03),
+        ("load-align", [li(1, 3), 0x7214], False, 6),
+        ("interrupt", [li(1, 1), swrite(1, 0)], True, 0x80000001),
+    ):
+        cases.append(Scenario(f"fatal-vector-{origin}", words_at(program), VECTOR, vector=4096, irq=irq, expected_cause=cause, fatal=True))
+    cases.append(Scenario("fatal-vector-misaligned", words_at([0xC5AF]), VECTOR, vector=VECTOR + 1, expected_cause=0x5A03, fatal=True))
+
+    return cases
+
+
+def run(command, *, cwd, env):
+    result = subprocess.run([str(x) for x in command], cwd=cwd, env=env,
+                            text=True, capture_output=True, timeout=180)
+    if result.returncode or any(line.lstrip().startswith("FAIL") for line in result.stdout.splitlines()):
+        raise RuntimeError(f"command failed: {command}\n{result.stdout}\n{result.stderr}")
+    return result.stdout
+
+
+def records(output):
+    return [(line.split(" ", 1)[0], json.loads(line.split(" ", 1)[1]))
+            for line in output.splitlines() if line.startswith(("RETIRE ", "FINAL "))]
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--bsc", default=".toolchain/bsc/bin/bsc")
+    parser.add_argument("--simulation", type=Path, default=ROOT.parent / "LightingSimulation")
+    parser.add_argument("--only", default="")
+    parser.add_argument("--verilator", help="also compare generated Verilog with Rust and Bluesim")
+    args = parser.parse_args()
+    bsc = Path(args.bsc).resolve()
+    simulation = args.simulation.resolve()
+    build = ROOT / "build" / "privilege-diff"
+    build.mkdir(parents=True, exist_ok=True)
+    env = os.environ.copy()
+    env["PATH"] = str(bsc.parent) + os.pathsep + env.get("PATH", "")
+    env["BLUESPECDIR"] = str(bsc.parent.parent / "lib")
+    search = "+:" + ":".join(str(ROOT / p) for p in ("rtl", "rtl/common", "rtl/cpu", "sim"))
+    top = "mkTbLightingCpuPrivilegeDiff"
+    run([bsc, "-u", "-sim", "-g", top, "-bdir", build, "-simdir", build, "-p", search,
+         ROOT / "tests/bsv/TbLightingCpuPrivilegeDiff.bsv"], cwd=ROOT, env=env)
+    exe = build / "runner"
+    run([bsc, "-sim", "-e", top, "-o", exe, "-bdir", build, "-simdir", build, "-p", search], cwd=ROOT, env=env)
+    verilog_exe = None
+    if args.verilator:
+        vdir = build / "verilog"
+        vdir.mkdir(exist_ok=True)
+        run([bsc, "-u", "-verilog", "-g", top, "-bdir", vdir, "-vdir", vdir, "-p", search,
+             ROOT / "tests/bsv/TbLightingCpuPrivilegeDiff.bsv"], cwd=ROOT, env=env)
+        wrapper = vdir / "sim_top.sv"
+        wrapper.write_text(f"""module sim_top;
+  logic CLK = 0;
+  logic RST_N = 0;
+  always #5 CLK = ~CLK;
+  initial #20 RST_N = 1;
+  {top} dut(.CLK(CLK), .RST_N(RST_N));
+endmodule
+""")
+        objdir = build / "verilator"
+        run([args.verilator, "--binary", "--timing", "-Wno-fatal", "-j", "2",
+             "--top-module", "sim_top", "--Mdir", objdir, "-o", "runner",
+             "-y", bsc.parent.parent / "lib/Verilog", wrapper, *sorted(vdir.glob("*.v"))], cwd=ROOT, env=env)
+        verilog_exe = objdir / "runner"
+    # Cargo's path dependency deliberately consumes the sibling checkout, not
+    # a Python translation of its semantics or a copied interpreter.
+    if simulation != ROOT.parent / "LightingSimulation":
+        raise ValueError("the oracle must be the sibling LightingSimulation checkout (Cargo path dependency)")
+    reference_target = build / "reference-target"
+    run(["cargo", "build", "--offline", "--manifest-path", ROOT / "tests/privilege-diff/reference/Cargo.toml",
+         "--target-dir", reference_target], cwd=ROOT, env=env)
+    reference = reference_target / "debug/sia-privilege-reference"
+    provenance = {}
+    for repo, source_dir, suffix in ((ROOT, "rtl", "*.bsv"), (simulation, "src", "*.rs")):
+        revision = run(['git', 'rev-parse', 'HEAD'], cwd=repo, env=env).strip()
+        digest = hashlib.sha256()
+        for source in sorted((repo / source_dir).rglob(suffix)):
+            digest.update(str(source.relative_to(repo)).encode() + b"\0" + source.read_bytes() + b"\0")
+        provenance[repo.name] = {"revision": revision, "source_sha256": digest.hexdigest()}
+        print(f"dependency {repo.name}: {revision}; source SHA256 {digest.hexdigest()}", flush=True)
+    (build / "provenance.json").write_text(json.dumps(provenance, indent=2) + "\n")
+    filters = args.only.split(",")
+    selected = [case for case in corpus() if any(term in case.name for term in filters)]
+    if not selected:
+        raise ValueError("no privilege scenario matched --only")
+    count = 0
+    for case in selected:
+        for delay in (0, 11):
+            directory = build / f"{case.name}-delay-{delay}"
+            directory.mkdir(exist_ok=True)
+            image = bytearray(4096)
+            for addr, word in case.words.items():
+                image[addr:addr + 2] = word.to_bytes(2, "little")
+            (directory / "program.bin").write_bytes(image)
+            (directory / "program.hex").write_text("\n".join(f"{int.from_bytes(image[i:i+2], 'little'):04x}" for i in range(0, 4096, 2)) + "\n")
+            config = [case.vector, case.reset, case.stop, int(case.irq), delay, 0, 0, 0]
+            (directory / "config.hex").write_text("\n".join(f"{x:08x}" for x in config) + "\n")
+            ref = records(run([reference, directory / "program.bin", case.vector, case.reset, case.stop, int(case.irq)], cwd=directory, env=env))
+            rtl = records(run([exe], cwd=directory, env=env))
+            (directory / "reference.json").write_text(json.dumps(ref, indent=2) + "\n")
+            (directory / "rtl.json").write_text(json.dumps(rtl, indent=2) + "\n")
+            if not ref or ref[-1][0] != "FINAL" or sum(kind == "FINAL" for kind, _ in ref) != 1:
+                raise AssertionError(f"{case.name}: missing/duplicate reference final record")
+            final = ref[-1][1]
+            if case.expected_cause is not None and final["cause"] != case.expected_cause:
+                raise AssertionError(f"{case.name}: oracle cause {final['cause']} != architectural expectation {case.expected_cause}")
+            if (final["stop"] == "trap_entry_failure") != case.fatal:
+                raise AssertionError(f"{case.name}: incorrect reference termination")
+            if ref != rtl:
+                for index in range(max(len(ref), len(rtl))):
+                    lhs = ref[index] if index < len(ref) else None
+                    rhs = rtl[index] if index < len(rtl) else None
+                    if lhs != rhs:
+                        raise AssertionError(f"{case.name} delay={delay} record={index}:\nreference: {lhs}\nRTL: {rhs}\nreplay: {directory}")
+            if verilog_exe:
+                generated = records(run([verilog_exe], cwd=directory, env=env))
+                (directory / "verilog.json").write_text(json.dumps(generated, indent=2) + "\n")
+                if ref != generated:
+                    raise AssertionError(f"{case.name} delay={delay}: generated Verilog differs from Rust; replay: {directory}")
+            count += 1
+        print(f"PASS {case.name}: Rust/RTL retirement + six system registers (delays 0,11)", flush=True)
+    print(f"PASS {count} privilege differential runs" + (" (Rust, Bluesim, generated Verilog)" if verilog_exe else ""), flush=True)
+    return 0
+
+
+if __name__ == "__main__":
+    try:
+        raise SystemExit(main())
+    except (RuntimeError, AssertionError, ValueError, subprocess.TimeoutExpired) as error:
+        print(error, file=sys.stderr)
+        raise SystemExit(1)
diff --git a/tests/system/TbLightingCpuBoardBridge.bsv b/tests/system/TbLightingCpuBoardBridge.bsv
new file mode 100644
index 0000000..f50496f
--- /dev/null
+++ b/tests/system/TbLightingCpuBoardBridge.bsv
@@ -0,0 +1,52 @@
+package TbLightingCpuBoardBridge;
+import Vector::*;
+import LightingComputeBoard::*;
+import LightingCpu::*;
+import LightingTypes::*;
+import LightingMemoryBus::*;
+import LightingInterrupts::*;
+function Bit#(8) byteOf(int x);return truncate(pack(x));endfunction
+function Bit#(32) readWord(int a,int b,int c,int d);return {byteOf(d),byteOf(c),byteOf(b),byteOf(a)};endfunction
+module mkTbLightingCpuBoardBridge(Empty);
+ LightingComputeBoardDebug board <- mkLightingComputeBoardCore;
+ Reg#(Bool) pending <- mkReg(False);
+ Reg#(Bool) grant <- mkReg(False);
+ Reg#(Bool) decoded <- mkReg(False);
+ Reg#(Bit#(8)) opcode <- mkReg(0);
+ Reg#(Bit#(8)) flags <- mkReg(0);
+ Reg#(Bit#(32)) value <- mkReg(0);
+ Reg#(Bit#(64)) observed <- mkReg(0);
+ Reg#(Bit#(32)) pc <- mkReg(0);
+ rule retirement(board.debugCpu.retireValid && board.debugCpu.retire.n!=observed);
+  observed<=board.debugCpu.retire.n;pc<=board.debugCpu.retire.nextPc;
+ endrule
+ rule reply(pending);
+  pending<=False;
+  // A bridge microstep must preserve the sampled grant while withholding a
+  // second completion. No physical request is serviced inside this process.
+  let p=board.mainboard.payload;let r=board.debugCpu.registers;
+  $display("CPU|%0d|%0d|%08x|%08x|%01x|%0d|%0d|%0d|%08x|%08x|%08x|%08x|%0d|%0d|%08x|%08x|%08x|%08x|%08x|%08x|%08x|%08x|%08x|%08x|%08x|%08x|%08x|%08x|%08x|%08x|%0d",
+   pack(board.mainboard.busRequest),pack(board.mainboard.request),p.addr,p.writeData,p.byteEnable,pack(p.write),pack(p.validate),observed,pc,board.debugCpu.cause,board.debugCpu.epc,board.debugCpu.badaddr,pack(board.debugCpu.running),pack(board.debugCpu.failure),r[0],r[1],r[2],r[3],r[4],r[5],r[6],r[7],r[8],r[9],r[10],r[11],r[12],r[13],r[14],r[15],p.accessKind);
+  $fflush(stdout);
+ endrule
+ rule holdGrant(!decoded || opcode!=67);
+  board.mainboard.driveInputs(LightingBusInputs{busGrant:grant,ready:False,error:False,readData:0});
+ endrule
+ rule initialize(decoded && opcode==83);
+  board.start(value);pc<=value;decoded<=False;pending<=True;
+ endrule
+ rule step(decoded && opcode==67);
+  board.mainboard.driveInputs(LightingBusInputs{busGrant:flags[0]==1,ready:flags[1]==1,error:flags[2]==1,readData:value});
+  board.driveInterrupts(LightingModuleInterrupts{plioIrq:flags[3]==1,timerIrq:flags[4]==1,machineFault:flags[5]==1});
+  grant<=flags[0]==1 && flags[1]==0 && flags[2]==0;decoded<=False;pending<=True;
+ endrule
+ rule command(!pending && !decoded);
+  int op <- $fgetc(stdin);
+  if(op==-1 || op==81)$finish(0);
+  else begin
+   int f <- $fgetc(stdin);int a <- $fgetc(stdin);int b <- $fgetc(stdin);int c <- $fgetc(stdin);int d <- $fgetc(stdin);
+   opcode<=truncate(pack(op));flags<=truncate(pack(f));value<=readWord(a,b,c,d);decoded<=True;
+  end
+ endrule
+endmodule
+endpackage
diff --git a/tests/translation-diff/cpu_run.py b/tests/translation-diff/cpu_run.py
new file mode 100644
index 0000000..1fd9507
--- /dev/null
+++ b/tests/translation-diff/cpu_run.py
@@ -0,0 +1,395 @@
+#!/usr/bin/env python3
+"""Real CPU+MMU execution, compared at each retirement with Rust."""
+from pathlib import Path
+import argparse, os, struct, random
+from run import ROOT, run, helper
+li=helper.li
+NOP=0xcfff
+
+def corpus():
+    # Physical boot installs root+ASID, enables VM, then resumes at a
+    # different physical frame. Wrong physical continuation is a BREAK.
+    for name in ('page','superpage','load-page-fault','store-page-fault','fetch-page-fault','load-access-fault','user-protection','sretctx','vmctx-switch','vm-disable','fatal-handler'):
+        image=bytearray(65536)
+        def word(pa,v):struct.pack_into('<I',image,pa,v)
+        def code(pa,words):
+            for i,v in enumerate(words):struct.pack_into('<H',image,pa+i*2,v)
+        boot=[li(1,1),0x51c6,0xf115,li(1,8),0xf110]
+        code(0,boot+[0xcfef,NOP,NOP,NOP,NOP,NOP])
+        word(0x1000,0x2001);word(0x2000,0x2801);word(0x2800,0x401f)
+        word(0x2810,0x5017) # VA0x2000 -> data PA0x5000 RWU
+        word(0x5000,0x12345678)
+        vector=0x100;stop=24
+        program=[li(1,1),0x51d6,0x7214,li(2,42),0x7217,0x7214,NOP,NOP]
+        if name=='superpage':
+            word(0x2000,0x1f);code(10,program);word(0x2000,0x1f)
+            # Data at VA0x2000 overlaps table: use VA0x8000 instead.
+            program[1]=0x51f6;code(10,program);word(0x8000,0x12345678)
+        else:code(0x400a,program)
+        if name=='load-page-fault':word(0x2810,0x5015);stop=vector
+        if name=='store-page-fault':word(0x2810,0x5013);stop=vector
+        if name=='load-access-fault':word(0x2810,0x10017);stop=vector
+        if name=='fetch-page-fault':word(0x2800,0x4013);stop=vector
+        if name=='fatal-handler':word(0x2800,0);stop=vector
+        if name=='user-protection':
+            # Return to User with VM retained, then deny U on data mapping.
+            code(0x400a,[li(3,32),0xf131,0xf300])
+            code(0x4020,program);word(0x2810,0x5007);stop=vector
+        if name in ('sretctx','vmctx-switch'):
+            # New root changes instruction frame on return; VM remains on.
+            word(0x3000,0x3801);word(0x3800,0x6001);word(0x6000,0x701f);word(0x6010,0x5017)
+            code(0x400a,[li(3,32),0xf131,li(1,3),0x51c6,0x6881,0xf311 if name=='sretctx' else 0xf115,0xb004]);code(0x7020,program);stop=46
+        if name=='vm-disable':
+            code(0x400a,[li(1,0),0xf110,0xcfef]);code(14,[li(4,37),NOP]);stop=16
+        if name!='fatal-handler':
+            handler_pa=vector if name=='superpage' else 0x4000+vector
+            # A supervisor-only second page holds the handler for NX code.
+            if name=='fetch-page-fault':
+                vector=0x800;stop=vector;word(0x2804,0x581b);handler_pa=0x5800
+            code(handler_pa,[li(7,31),NOP,NOP])
+        yield name,image,vector,stop
+
+    image=bytearray(65536)
+    def word(pa,v):struct.pack_into('<I',image,pa,v)
+    def code(pa,words):
+        for i,v in enumerate(words):struct.pack_into('<H',image,pa+i*2,v)
+    code(0,[li(1,1),0x51c6,0xf115,li(1,8),0xf110,0xcfef])
+    word(0x1000,0x2001);word(0x2000,0x2801);word(0x2800,0x401f);word(0x2804,0x602b)
+    word(0x3000,0x3801);word(0x3800,0x6801);word(0x6800,0x701f);word(0x6804,0x602b)
+    code(0x400a,[li(3,32),0xf131,0xf300])
+    code(0x4020,[li(4,11),0xc00f,li(7,33),NOP])
+    code(0x7020,[li(5,22),0xc00f,0xcfef,NOP])
+    code(0x6000,[0x6b01,li(3,36),0xf131,li(1,1),0x51c6,0xa285,
+                 li(1,3),0x51c6,0x6881,li(3,32),0xf131,0xf311,NOP])
+    yield 'warm-context-return',image,0x800,36
+
+def publication_corpus():
+    for name in ('sync-next-word','sync-user','pte-publish-all','pte-publish-va','pte-publish-asid','pte-publish-new-code','ldpc-negative','ldpc-page-fault'):
+        image=bytearray(65536)
+        def word(pa,v):struct.pack_into('<I',image,pa,v)
+        def code(pa,words):
+            for i,v in enumerate(words):struct.pack_into('<H',image,pa+i*2,v)
+        vector=0x100;stop=16
+        if name.startswith('sync'):
+            # Rewrite the very next instruction after SYNC.I. No branch flush
+            # may conceal stale prefetch/decode state in this test.
+            code(0,[0x910f,li(2,16),0x7127,NOP,NOP,NOP,NOP,0xf600,li(7,1),NOP])
+            word(64,li(7,37)|(NOP<<16))
+            if name=='sync-user':
+                code(0,[li(3,32),0xf131,0xf300])
+                code(32,[0x910f,li(2,48),0x7127,NOP,NOP,NOP,NOP,0xf600,li(7,1),NOP])
+                word(96,li(7,37)|(NOP<<16));stop=48
+        elif name=='pte-publish-new-code':
+            # Populate a writable, non-executable page through guest stores,
+            # grant X with a PTE update, then fence translation and instruction
+            # streams. The store warms a data TLB entry that must be discarded.
+            code(0,[li(1,1),0x51c6,0xf115,li(1,8),0xf110])
+            word(0x1000,0x2001);word(0x2000,0x2801);word(0x2800,0x401f)
+            word(0x2804,0x6017);word(0x2810,0x2817)
+            vector=0x180
+            code(0x400a,[0x913d,0x923e,0x7217,0x923e,0x933f,0x7237,0xf411,0xf600,0xc010])
+            word(0x4100,0x800);word(0x4108,li(7,37)|(NOP<<16))
+            word(0x410c,0x601f);word(0x4110,0x2004)
+            code(0x6000,[li(7,1),NOP,NOP]);stop=0x804
+        elif name=='ldpc-negative':
+            code(0,[0xb003,NOP,NOP,NOP,0x93fe,NOP]);word(4,0x12345678);stop=8
+        elif name=='ldpc-page-fault':
+            code(0,[li(1,1),0x51c6,0xf115,li(1,8),0xf110])
+            word(0x1000,0x2001);word(0x2000,0x2801);word(0x2800,0x400b)
+            code(0x400a,[0x9100]);code(0x4100,[NOP]);stop=vector
+        else:
+            # Warm VA0x800's old executable frame, replace its PTE through a
+            # writable alias, fence the selected scope, then publish new code.
+            code(0,[li(1,1),0x51c6,0xf115,li(1,8),0xf110])
+            word(0x1000,0x2001);word(0x2000,0x2801);word(0x2800,0x401f)
+            word(0x2804,0x501f);word(0x2810,0x2817)
+            # LDPC literal constants live in the current executable frame.
+            vector=0x180
+            code(0x400a,[0x913d,0xce10,NOP,0x923d,0x933e,0x7237,0x943e,
+                         {'pte-publish-all':0xf400,'pte-publish-va':0xf441,'pte-publish-asid':0xf442}[name],0xf600,0xc010,NOP])
+            word(0x4100,0x800);word(0x4108,0x601f);word(0x410c,0x2004)
+            word(0x4110,0 if name=='pte-publish-asid' else 0x800)
+            code(0x5000,[li(7,11),0xc0e0]);code(0x6000,[li(7,37),NOP,NOP]);stop=0x804
+        code(0x4000+vector if name.startswith('pte') or name=='ldpc-page-fault' else vector,[NOP])
+        yield name,image,vector,stop
+
+def multi_corpus():
+    # Noncontiguous frames across a 2 KiB page boundary. Store tests read back
+    # every constituent, so register parity also checks actual memory effects.
+    cases=[(f'multi-op-{fn}',fn,None) for fn in range(10)]
+    cases += [(f'multi-{kind}-fault-{position}',6 if kind=='load' else 8,position)
+              for kind in ('load','store') for position in range(4)]
+    cases += [(f'multi-{kind}-access-fault-{position}',6 if kind=='load' else 8,f'physical-{position}')
+              for kind in ('load','store') for position in range(4)]
+    cases += [('multi-user-load-fault-1',6,'user'),('multi-user-store-fault-1',8,'user')]
+    cases += [('multi-mmio-load',0,'mmio'),('multi-mmio-store',2,'mmio'),
+              ('multi-wrap',5,'wrap'),('multi-overlap-load',6,'overlap'),
+              ('multi-align-load',0,'align'),('multi-align-store',9,'align'),
+              ('multi-reserved',10,'reserved'),('multi-r0',5,'r0'),
+              ('multi-store-base-overlap',8,'store-overlap')]
+    for name,fn,fault in cases:
+        image=bytearray(65536)
+        def word(pa,v):struct.pack_into('<I',image,pa,v)
+        def code(pa,words):
+            for j,v in enumerate(words):struct.pack_into('<H',image,pa+j*2,v)
+        word(0x1000,0x2001);word(0x2000,0x2801);word(0x2800,0x401f)
+        count=2 if fn<5 else 4;store=fn in (2,3,4,7,8,9)
+        # For fault position N, exactly N words occupy the first mapped page.
+        split=fault if isinstance(fault,int) else (int(fault.rsplit('-',1)[1]) if isinstance(fault,str) and fault.startswith('physical-') else 1)
+        address=0x2800-split*4
+        word(0x2810,0x5017);word(0x2814,0x7817)
+        if isinstance(fault,int):word(0x2814,0x7813 if store else 0x7815)
+        if isinstance(fault,str) and fault.startswith('physical-'):word(0x2814,0x10017)
+        if fault=='user':word(0x2814,0x7807)
+        for j in range(4):
+            va=address+j*4;pa=0x5000+(va-0x2000) if va<0x2800 else 0x7800+(va-0x2800)
+            word(pa,0xabc000+j)
+        base=address+count*4 if fn in (4,9) else address
+        if fault=='mmio':
+            base=0xfff03000
+            word(0x10fc,0x3001);word(0x30fc,0x3801);word(0x3818,0xfff03017)
+        if fault=='align':base+=1
+        first=14 if fault=='wrap' else (0 if fault=='r0' else 3)
+        base_reg=4 if fault in ('overlap','store-overlap') else 1
+        code(0,[li(1,1),0x51c6,0xf115,li(1,8),0xf110,0xcfef])
+        program=[li(3,11),li(4,22),li(5,33),li(6,44)]
+        # LDPC at VA18 points at VA64.
+        program += [0x9000|(base_reg<<8)|11,0x8000|(first<<8)|(base_reg<<4)|fn]
+        stop=22
+        if store and not isinstance(fault,int) and fault not in ('mmio','align'):
+            # Reload original start independently of writeback/base overlap.
+            program += [0x910a,0x8810 if count==2 else 0x8815,NOP];stop=26
+        else:program += [NOP]
+        if fault=='user':
+            program[4]=0x9107
+            code(0x400a,[li(2,24),0xf121,0xf300]);code(0x4018,program)
+        else:code(0x400a,program)
+        word(0x4040,base);word(0x4044,address)
+        # LDPC at VA22 aligns PC+4 to24 + 10*4 =64, use original literal for
+        # predecrement stores and the original start literal for every store.
+        if store and stop==26:struct.pack_into('<H',image,0x4016,0x910b)
+        vector=0x100
+        if fault not in (None,'r0','store-overlap'):stop=vector
+        code(0x4100,[NOP,NOP])
+        yield name,image,vector,stop
+
+def scaled_corpus():
+    # Directed instruction execution: aliasing, wrapping, zero registers and
+    # precise alignment/translation/physical faults. Store successes reload the
+    # same indexed address, checking memory as well as architectural registers.
+    variants=('basic','base-alias','index-alias','zero-base','zero-index',
+              'shift-wrap','add-wrap','negative-index','next-page','physical',
+              'alignment','permission','user','access')
+    for store in (False,True):
+        for variant in variants:
+            name=f'scaled-{"sta" if store else "lda"}-{variant}'
+            yield scaled_image(name,store,variant)
+    yield scaled_image('scaled-sta-zero-source',True,'zero-source')
+    yield scaled_image('scaled-sta-all-zero',True,'all-zero')
+    yield scaled_image('scaled-cpop-escape',False,'cpop')
+
+def scaled_image(name,store,variant):
+    image=bytearray(65536)
+    def word(pa,value):struct.pack_into('<I',image,pa,value)
+    def code(pa,words):
+        for i,value in enumerate(words):struct.pack_into('<H',image,pa+2*i,value)
+    vm=variant!='physical';start=32 if variant=='user' else (10 if vm else 0)
+    base=0x2000;index=1;rb=1;ri=2;rv=3
+    if variant=='base-alias':rv=rb
+    if variant=='index-alias':rv=ri
+    if variant=='zero-base':base=0;rb=0;index=0x801
+    if variant=='zero-index':base=0x2004;ri=0;index=0
+    if variant=='shift-wrap':index=0x40000001
+    if variant=='add-wrap':base=0xfffffffc;index=0x802
