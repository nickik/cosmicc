+        (d/'config.hex').write_text(''.join(f'{w:08x}\n' for w in [vector,0,stop,0,3 if name=='warm-context-return' else 0,validation_count,access_count,mode]))
+        expected=helper.records(run([oracle,'memory.bin',str(vector),'0',str(stop),'0'],cwd=d,env=env))
