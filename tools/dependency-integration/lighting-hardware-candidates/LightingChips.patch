+    rule monitor(phase==12);
+        cycles<=cycles+1;
+        if(cycles==3000||mainboard.protocolError)begin $display("FAIL multi board protocol/timeout pc=%08x epc=%08x cause=%08x bad=%08x validations=%0d accesses=%0d req=%0d addr=%08x",board.debugCpu.nextFetchPc,board.debugCpu.epc,board.debugCpu.cause,board.debugCpu.badaddr,validations,accesses,board.mainboard.request,board.mainboard.payload.addr);$finish(1);end
+        if(board.mainboard.request&&!active)begin
+            let p=board.mainboard.payload;
+            active<=True;
+            if(p.validate)begin
+                validations<=validations+1;
+                if(p.byteEnable!=15)begin $display("FAIL validation width");$finish(1);end
+            end
+            else if(p.addr==64||p.addr==68)begin
+                accesses<=accesses+1;
+                if(validations<2)begin $display("FAIL board transfer before validation");$finish(1);end
+            end
+            else if(p.addr==32'hfff03000)begin $display("FAIL MMIO target access");$finish(1);end
+        end
+        if(!board.mainboard.request)active<=False;
+    endrule
+    rule finish(phase==12&&board.debugCpu.retireValid&&board.debugCpu.retire.pc==32'hfffff000);
+        let r=board.debugCpu.registers;
+        if(board.debugCpu.epc!=18||board.debugCpu.badaddr!=32'hfff03000||r[1]!=64||r[3]!=11||r[4]!=22||r[5]!=11||r[6]!=22||r[7]!=0||validations!=5||accesses!=4||mainboard.peekRamWord(64)!=11||mainboard.peekRamWord(68)!=22)begin
+            $display("FAIL production multi board state epc=%08x badaddr=%08x validation=%0d accesses=%0d",board.debugCpu.epc,board.debugCpu.badaddr,validations,accesses);$finish(1);
+        end
+        $display("PASS production CPU/MMU/bus multi-store/load validation and MMIO rejection under stalls");$finish(0);
+    endrule
+endmodule
+endpackage
