+package TbModuleBusAdapterStaleGrant;
+import PhysicalMem::*;
+import LightingMemoryBus::*;
+import ModuleBusAdapter::*;
+module mkTbModuleBusAdapterStaleGrant(Empty);
+ ModuleBusAdapter dut <- mkModuleBusAdapter;
+ Reg#(Bit#(4)) phase <- mkReg(0);
+ Reg#(Bit#(8)) cycles <- mkReg(0);
+ rule timeout;cycles<=cycles+1;if(cycles==30)begin $display("FAIL stale grant timeout");$finish(1);end endrule
+ rule pins;
+  dut.bus.driveInputs(LightingBusInputs{busGrant:True,ready:phase<5 || phase==7,error:phase==5,readData:phase==7 ? 32'h12345678:32'hdeadbeef});
+ endrule
+ rule issue(phase==0 && dut.physical.canRequest);
+  dut.physical.request(PhysicalMemRequest{accessKind: 0, validate:False,addr:32'h80,writeData:0,byteEnable:15,write:False});phase<=1;
+ endrule
+ rule waitForFreshGrant(phase>=1 && phase<=6);
+  if(!dut.bus.busRequest || dut.bus.request || dut.physical.responseValid || dut.bus.payload.addr!=32'h80)begin
+   $display("FAIL stale completion acquired/changed new request phase=%0d",phase);$finish(1);
+  end
+  phase<=phase+1;
+ endrule
+ rule complete(phase==7);
+  if(!dut.bus.request)begin $display("FAIL fresh grant did not activate request");$finish(1);end
+  phase<=8;
+ endrule
+ rule check(phase==8 && dut.physical.responseValid);
+  if(dut.physical.response.error || dut.physical.response.readData!=32'h12345678 || dut.bus.request)begin $display("FAIL wrong completion from stale grant");$finish(1);end
+  $display("PASS adapter ignores stale READY/ERROR grants before a fresh grant");$finish(0);
+ endrule
+endmodule
+endpackage
