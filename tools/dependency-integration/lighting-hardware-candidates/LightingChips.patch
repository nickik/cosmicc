+package LightingMulDiv;
+
+// Iterative optional SIA-Zmul/SIA-M arithmetic. No combinational multiplier
+// or divider: one shift/add or restoring-division step per cycle.
+interface LightingMulDiv;
+ method Bool canStart;
+ method Action start(Bit#(4) op, Bit#(32) a, Bit#(32) b);
+ method Bool responseValid;
+ method Bit#(32) result;
+ method Bool arithmeticFault;
+ method Action consumeResponse;
+ method Action resetUnit;
+endinterface
+
+module mkLightingMulDiv(LightingMulDiv);
+ Reg#(Bool) active <- mkReg(False);
+ Reg#(Bool) valid <- mkReg(False);
+ Reg#(Bool) fault <- mkReg(False);
+ Reg#(Bit#(32)) outputValue <- mkReg(0);
+ Reg#(Bit#(4)) operation <- mkReg(0);
+ Reg#(Bit#(6)) count <- mkReg(0);
+ Reg#(Bit#(64)) accumulator <- mkReg(0);
+ Reg#(Bit#(64)) multiplicand <- mkReg(0);
+ Reg#(Bit#(32)) multiplier <- mkReg(0);
+ Reg#(Bit#(32)) dividend <- mkReg(0);
+ Reg#(Bit#(32)) divisor <- mkReg(0);
+ Reg#(Bit#(33)) remainder <- mkReg(0);
+ Reg#(Bit#(32)) quotient <- mkReg(0);
+ Reg#(Bool) negateProduct <- mkReg(False);
+ Reg#(Bool) negateQuotient <- mkReg(False);
+ Reg#(Bool) negateRemainder <- mkReg(False);
+
+ rule iterate(active);
+  if(operation<=9)begin
+   Bit#(64) sum=accumulator+(multiplier[0]==1 ? multiplicand:0);
+   accumulator<=sum;multiplicand<=multiplicand<<1;multiplier<=multiplier>>1;
+   if(count==31)begin
+    Bit#(64) product=negateProduct ? 0-sum:sum;
+    Bit#(32) low=truncate(product);
+    Bit#(32) high=truncate(product>>32);
+    Bool overflow=high!=(low[31]==1 ? 32'hffffffff:0);
+    outputValue<=operation>=6 && operation<=8 ? high:low;
+    fault<=operation==9 && overflow;active<=False;valid<=True;
+   end
+  end
+  else begin
+   Bit#(33) candidate=(remainder<<1)|zeroExtend(dividend[31]);
+   Bool subtract=candidate>=zeroExtend(divisor);
+   Bit#(33) nextRemainder=subtract ? candidate-zeroExtend(divisor):candidate;
+   Bit#(32) nextQuotient=(quotient<<1)|zeroExtend(pack(subtract));
+   remainder<=nextRemainder;quotient<=nextQuotient;dividend<=dividend<<1;
+   if(count==31)begin
+    Bit#(32) unsignedRemainder=truncate(nextRemainder);
+    outputValue<=operation>=12 ? (negateRemainder ? 0-unsignedRemainder:unsignedRemainder):(negateQuotient ? 0-nextQuotient:nextQuotient);
+    fault<=False;active<=False;valid<=True;
+   end
+  end
+  count<=count+1;
+ endrule
+
+ method Bool canStart=!active&&!valid;
+ method Action start(Bit#(4) op,Bit#(32) a,Bit#(32) b) if(!active&&!valid);
+  Bool signedA=op==6||op==8||op==9||op==10||op==12;
+  Bool signedB=op==6||op==9||op==10||op==12;
+  Bool negativeA=signedA&&a[31]==1;Bool negativeB=signedB&&b[31]==1;
+  Bit#(32) magnitudeA=negativeA ? 0-a:a;
+  Bit#(32) magnitudeB=negativeB ? 0-b:b;
+  Bool invalid=op<5||op>13;
+  Bool exceptional=invalid||(op>=10&&(b==0||(op==10&&a==32'h80000000&&b==32'hffffffff)));
+  operation<=op;count<=0;accumulator<=0;multiplicand<=zeroExtend(magnitudeA);multiplier<=magnitudeB;
+  dividend<=magnitudeA;divisor<=magnitudeB;remainder<=0;quotient<=0;
+  negateProduct<=negativeA!=negativeB;negateQuotient<=negativeA!=negativeB;negateRemainder<=negativeA;
+  active<=!exceptional;valid<=exceptional;fault<=exceptional;outputValue<=0;
+ endmethod
+ method Bool responseValid=valid;
+ method Bit#(32) result if(valid)=outputValue;
+ method Bool arithmeticFault if(valid)=fault;
+ method Action consumeResponse if(valid);valid<=False;endmethod
+ method Action resetUnit;active<=False;valid<=False;fault<=False;endmethod
+endmodule
+endpackage
