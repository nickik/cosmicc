+++ b/rtl/common/CpuMmu.bsv
@@ -24,7 +24,14 @@ typedef struct {
     MmuFault fault;
 } CpuInstructionResponse deriving (Bits, Eq, FShow);
 
+// Version 1: validation translates and checks NORMAL physical memory without
+// target access; successful readData is the captured PA. Commit replays that PA
+// with translation disabled, only after the entire group has validated.
+typedef enum { CpuDataAccess, CpuDataValidate, CpuDataCommit }
+    CpuDataKind deriving (Bits, Eq, FShow);
+
 typedef struct {
+    CpuDataKind   kind;
     SiaAddr       virtualAddress;
     MemWidth      width;
     Bool          write;
