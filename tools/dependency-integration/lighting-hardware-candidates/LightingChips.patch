+        wrapper=vdir/'sim_top.sv'
+        wrapper.write_text(f'module sim_top; logic CLK=0; logic RST_N=0; always #5 CLK=~CLK; initial #20 RST_N=1; {top} dut(.CLK(CLK),.RST_N(RST_N)); endmodule\n')
+        obj=build/'verilator'
+        run([a.verilator,'--binary','--timing','-Wno-fatal','-j','2','--top-module','sim_top','--Mdir',obj,'-o','runner','-y',bsc.parent.parent/'lib/Verilog',wrapper,*sorted(vdir.glob('*.v'))],cwd=ROOT,env=env)
+        vexe=obj/'runner'
+    target=build/'reference-target'
+    run(['cargo','build','--offline','--manifest-path',ROOT/'tests/translation-diff/reference/Cargo.toml','--target-dir',target],cwd=ROOT,env=env)
+    reference=target/'debug/sia-translation-reference'
+    n=0
+    for name,va,flags,superpage,access,mode,fault,width in cases():
+        if a.only and a.only not in name:continue
+        image,va,ctx=image_for(va,flags,superpage,fault)
+        directory=build/name;directory.mkdir(exist_ok=True)
+        (directory/'memory.bin').write_bytes(image)
+        (directory/'memory.hex').write_text(''.join(f'{w:08x}\n' for (w,) in struct.iter_unpack('<I',image)))
+        pa=(va&0xfffff) if superpage else 0x5000|(va&2047)
+        old=struct.unpack_from('<I',image,pa&~3)[0]
+        shift=(pa&3)*8;mask=((1<<(width*8))-1)<<shift
+        stored=(old&~mask)|((0xdeadcafe<<shift)&mask)
+        cfg=[ctx,va,access,mode,width,pa,stored,0]
+        (directory/'config.hex').write_text(''.join(f'{w:08x}\n' for w in cfg))
+        def result(output):return next(line for line in output.splitlines() if line.startswith('RESULT '))
+        expected=result(run([reference,'memory.bin','config.hex'],cwd=directory,env=env))
+        for runner in [exe]+([vexe] if vexe else []):
+            actual=result(run([runner],cwd=directory,env=env))
+            if actual!=expected:raise AssertionError(f'{name}: {runner}: Rust {expected}; RTL {actual}')
+        n+=1
+        print(f'PASS {name}',flush=True)
+    if not n:raise ValueError('no cases selected')
+    print(f'PASS {n} translation cases: Rust/Bluesim'+('/Verilog' if vexe else ''))
+if __name__=='__main__':main()
