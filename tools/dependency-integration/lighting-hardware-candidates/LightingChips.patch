diff --git a/tests/boot/workload.fg b/tests/boot/workload.fg
new file mode 100644
index 0000000..5e5c673
--- /dev/null
+++ b/tests/boot/workload.fg
@@ -0,0 +1,18 @@
+module lighting.hardware_boot;
+
+type Word = *volatile u32;
+
+fn main() -> i32 {
+    var total: u32 = 0;
+    var i: u32 = 1;
+    while (i < 11) {
+        total = total + i;
+        i = i + 1;
+    }
+    unsafe {
+        val address: u32 = 0x2100;
+        val result: Word = Word(address);
+        *result = total;
+    }
+    return 55;
+}
