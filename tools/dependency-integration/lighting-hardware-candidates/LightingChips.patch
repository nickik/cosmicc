+        wrapper=vd/'sim_top.sv';wrapper.write_text(f'module sim_top; logic CLK=0; logic RST_N=0; always #5 CLK=~CLK; initial #20 RST_N=1; {top} dut(.CLK(CLK),.RST_N(RST_N)); endmodule\n')
+        obj=build/'verilator';run([a.verilator,'--binary','--timing','-Wno-fatal','-j','2','--top-module','sim_top','--Mdir',obj,'-o','runner','-y',bsc.parent.parent/'lib/Verilog',wrapper,*sorted(vd.glob('*.v'))],cwd=ROOT,env=env);vexe=obj/'runner'
+    target=build/'reference-target';run(['cargo','build','--offline','--manifest-path',ROOT/'tests/translation-diff/reference/Cargo.toml','--target-dir',target],cwd=ROOT,env=env)
+    oracle=target/'debug/sia-translated-cpu-reference'
+    cases=[*corpus(),*publication_corpus(),*multi_corpus(),*scaled_corpus(),*updating_corpus(),*muldiv_corpus()]
+    arithmetic_cases={name:(op,a,b,rd,rs) for op,a,b,rd,rs,name in muldiv_vectors()}
+    for name,image,vector,stop in cases:
+        d=build/name;d.mkdir(exist_ok=True);(d/'memory.bin').write_bytes(image)
