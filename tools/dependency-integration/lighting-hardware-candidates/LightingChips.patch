+++ b/tests/bsv/TbLightingComputeBoardTranslation.bsv
@@ -0,0 +1,62 @@
+package TbLightingComputeBoardTranslation;
+import LightingTypes::*;
+import LightingCpu::*;
+import LightingComputeBoard::*;
+import LightingMemoryBus::*;
+import FakeMainboard::*;
+module mkTbLightingComputeBoardTranslation(Empty);
+    LightingComputeBoardDebug board <- mkLightingComputeBoardCore;
+    FakeMainboard mainboard <- mkFakeMainboard;
+    Reg#(Bit#(5)) phase <- mkReg(0);
+    Reg#(Bit#(16)) cycles <- mkReg(0);
+    Reg#(Bool) sawL2 <- mkReg(False);
+    Reg#(Bool) sawL1 <- mkReg(False);
+    Reg#(Bool) sawL0 <- mkReg(False);
+    Reg#(Bool) sawStore <- mkReg(False);
+    Reg#(Bool) sawLoad <- mkReg(False);
+    rule init(phase<13);
+        Bit#(32) addr=0;Bit#(32) value=0;
+        case(phase)
+            0:begin addr=0;value=32'h51c66081;end
+            1:begin addr=4;value=32'h6088f115;end
+            2:begin addr=8;value=32'hcfeff110;end
+            3:begin addr=32'h1000;value=32'h2001;end
+            4:begin addr=32'h2000;value=32'h2801;end
+            5:begin addr=32'h2800;value=32'h401b;end
+            6:begin addr=32'h2810;value=32'h5007;end
+            7:begin addr=32'h4008;value=32'h6081cfff;end
+            8:begin addr=32'h400c;value=32'h721451d6;end
+            9:begin addr=32'h4010;value=32'h7217612a;end
+            10:begin addr=32'h4014;value=32'h72146100;end
+            11:begin addr=32'h4018;value=32'hcfffcfff;end
+            12:begin addr=32'h5000;value=32'hdeadbeef;end
+        endcase
+        mainboard.pokeRamWord(addr,value);phase<=phase+1;
+    endrule
+    rule configure(phase==13);mainboard.configure(3,5,False);phase<=14;endrule
+    rule startBoard(phase==14);board.start(0);phase<=15;endrule
+    rule connect(phase==15);
+        mainboard.connect(board.mainboard.busRequest,board.mainboard.request,board.mainboard.payload);
+    endrule
+    rule drive(phase==15);board.mainboard.driveInputs(mainboard.inputs);endrule
+    rule observe(phase==15 && board.mainboard.request);
+        let p=board.mainboard.payload;
+        if(p.addr==32'h1000)sawL2<=True;
+        if(p.addr==32'h2000)sawL1<=True;
+        if(p.addr==32'h2800)sawL0<=True;
+        if(p.addr==32'h5000)begin
+            if(p.byteEnable!=15 || (p.write && p.writeData!=42))begin $display("FAIL translated board data lanes");$finish(1);end
+            if(p.write)sawStore<=True;else sawLoad<=True;
+        end
+    endrule
+    rule watchdog(phase==15);
+        cycles<=cycles+1;
+        if(cycles==3000 || mainboard.protocolError || board.debugCpu.failure!=CpuFailureNone)begin $display("FAIL translated board cycle=%0d failure=%0d",cycles,board.debugCpu.failure);$finish(1);end
+    endrule
+    rule finish(phase==15 && board.debugCpu.retireValid && board.debugCpu.retire.n==13);
+        let r=board.debugCpu.retire;
+        if(r.pc!=24 || r.insn!=16'hcfff || r.regs[2]!=42 || board.debugCpu.status!=8 || board.mmuVmctx!=32'h1000 || !sawL2 || !sawL1 || !sawL0 || !sawStore || !sawLoad)begin $display("FAIL translated board retirement pc=%08x n=%0d",r.pc,r.n);$finish(1);end
+        $display("PASS production board translated fetch/load/store and three-level page walks over stalled mainboard bus");$finish(0);
+    endrule
+endmodule
+endpackage
