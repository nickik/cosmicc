+    run([bsc,'-u','-sim','-g',top,'-bdir',build,'-simdir',build,'-p',search,src],cwd=ROOT,env=env)
+    exe=build/'runner';run([bsc,'-sim','-e',top,'-o',exe,'-bdir',build,'-simdir',build,'-p',search],cwd=ROOT,env=env)
