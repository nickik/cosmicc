+#!/usr/bin/env python3
+"""Fresh bounded directed RTL checks for the hardware CPU integration closure."""
+import argparse, importlib.util, os, pathlib, subprocess, sys
+ROOT=pathlib.Path(__file__).resolve().parents[1]
+TESTS=['LightingCpu','LightingCpuMulDivInterrupt','LightingMulDiv','ModuleBusAdapterStaleGrant','LightingComputeBoardMulti','LightingComputeBoardTranslation']
+def main():
+ p=argparse.ArgumentParser();p.add_argument('--bsc',required=True);p.add_argument('--timeout',type=int,default=240);a=p.parse_args()
+ env=dict(os.environ);bsc=pathlib.Path(a.bsc).resolve();env['PATH']=str(bsc.parent)+os.pathsep+env['PATH'];env['BLUESPECDIR']=str(bsc.parent.parent/'lib')
