@@ -0,0 +1,46 @@
+package TbLightingCpuMulDivInterrupt;
+import LightingTypes::*;
+import LightingCpu::*;
+import FlatCpuMemory::*;
+module mkTbLightingCpuMulDivInterrupt(Empty);
+ FlatCpuMemory memory <- mkFlatCpuMemory;
+ LightingCpu cpu <- mkLightingCpuWithTrapVector(memory.cpu,32'h80);
+ Reg#(Bit#(4)) phase <- mkReg(0);
+ Reg#(Bit#(16)) cycles <- mkReg(0);
+ Reg#(Bool) driven <- mkReg(False);
+ Reg#(Bool) sawProduct <- mkReg(False);
+ rule initialize(phase<8);
+  case(phase)
+   0:memory.pokeInstruction(0,16'h6081); // LI r1,1: IE
+   1:memory.pokeInstruction(2,16'hf110); // STATUS
+   2:memory.pokeInstruction(4,16'h6107); // LI r2,7
+   3:memory.pokeInstruction(6,16'h6183); // LI r3,3
+   4:memory.pokeInstruction(8,16'hc235); // MUL r2,r3
+   5:memory.pokeInstruction(10,16'h6201); // younger LI r4,1
+   6:memory.pokeInstruction(32'h80,16'hcfff);
+   7:cpu.start(0);
+  endcase
+  phase<=phase+1;
+ endrule
+ rule assertInterrupt(phase==8&&!driven&&cpu.retireValid&&cpu.retire.pc==6);
+  cpu.setPlatformInterrupt(True);driven<=True;
+ endrule
+ rule observe(phase==8&&cpu.retireValid);
+  let r=cpu.retire;
+  if(r.pc==8)begin
+   if(r.regs[2]!=21||r.n!=5)begin $display("FAIL arithmetic retirement");$finish(1);end
+   sawProduct<=True;
+  end
+  if(r.pc==32'h80)begin
+   if(!sawProduct||!driven||cpu.epc!=10||cpu.cause!=32'h80000001||r.regs[2]!=21||r.regs[4]!=0)begin
+    $display("FAIL arithmetic interrupt epc=%08x cause=%08x",cpu.epc,cpu.cause);$finish(1);
+   end
+   $display("PASS arithmetic precise interrupt boundary");$finish(0);
+  end
+ endrule
+ rule watchdog(phase==8);
+  cycles<=cycles+1;
+  if(cycles==2000)begin $display("FAIL arithmetic interrupt timeout");$finish(1);end
+ endrule
+endmodule
+endpackage
