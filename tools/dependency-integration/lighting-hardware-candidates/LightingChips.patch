 package PhysicalMem;
 
 typedef struct {
+    Bit#(2) accessKind; // 0=data, 1=instruction, 2=page table, 3=reserved
+    Bool     validate;
     Bit#(32) addr;
     Bit#(32) writeData;
     Bit#(4)  byteEnable;
@@ -12,7 +14,11 @@ typedef struct {
     Bool     error;
 } PhysicalMemResponse deriving (Bits, Eq, FShow);
 
-// MMU-facing physical-memory contract. Version 0 permits exactly one
+// MMU-facing physical-memory contract. Version 2 preserves data/fetch/walker
+// classification through the mainboard. Fetches permit NORMAL RAM/ROM; walks
+// require installed coherent RAM. Reserved class, writes or validation with a
+// non-data class fault before target access. Version 1 NORMAL validation remains
+// side-effect free. A mainboard must implement both. It permits exactly one
 // outstanding transaction. A request remains owned by the receiver until a
 // response is consumed; there are deliberately no transaction tags or
 // reordering semantics yet.
