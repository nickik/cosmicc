+#!/usr/bin/env python3
+"""Compare real MMU RTL with the sibling Rust MMU, including Verilog."""
+import argparse
+import importlib.util
+import os
+from pathlib import Path
+import struct
+
+ROOT = Path(__file__).resolve().parents[2]
+spec = importlib.util.spec_from_file_location('privilege_runner', ROOT/'tests/privilege-diff/run.py')
+helper = importlib.util.module_from_spec(spec)
+import sys
+sys.modules[spec.name] = helper
+spec.loader.exec_module(helper)
+run = helper.run
+
+def cases():
+    va = 0x0c502806  # nonzero 6/6/9 indices; high halfword lane
+    for superpage in (False, True):
+        for flags in range(64):
+            for access in range(3):
+                for supervisor in range(2):
+                    yield f'permissions-{superpage}-{flags}-{access}-{supervisor}', va, flags, superpage, access, supervisor, '', 2
+    for address in (0x00000000,0xfffff806,0x03fff806,0x04000000):
+        for access in range(3):
+            yield f'boundary-{address:08x}-{access}', address, 0x7ff, False, access, 0, '', 2
+    for fault in ('invalid-l2','leaf-l2','invalid-l1','pointer-l0','invalid-l0','misaligned-superpage','bus-l2','bus-l1','bus-l0','bus-target'):
+        for access in range(3):
+            yield f'{fault}-{access}', va, 63, fault=='misaligned-superpage', access, 1, fault, 2
+    for width in (1,2,4):
+        for offset in range(0,8,width):
+            for access in (1,2):
+                yield f'lane-{width}-{offset}-{access}', (va & ~7)+offset, 63, False, access, 0, '', width
+
+def image_for(va, flags, superpage, fault):
+    image=bytearray(65536)
+    def put(pa,value): struct.pack_into('<I',image,pa,value)
+    root=0x1000; l1=0x2800; l0=0x3800; frame=0x5000
+    # Superpage target must fit test RAM: use PA base zero and a low VA offset.
+    if superpage: va=(va&0xfff00000)|0x2806
+    p2=root+((va>>26)&63)*4
+    p1=l1+((va>>20)&63)*4
+    p0=l0+((va>>11)&511)*4
+    put(p2,l1|1);put(p1,flags if superpage else l0|1)
+    put(p0,frame|flags)
+    pa=(va&0xfffff) if superpage else frame|(va&2047)
+    put(pa&~3,0x98765432)
+    changes={'invalid-l2':(p2,0),'leaf-l2':(p2,l1|15),'invalid-l1':(p1,0),'pointer-l0':(p0,frame|1),'invalid-l0':(p0,0),'misaligned-superpage':(p1,0x800|flags),'bus-l1':(p2,0x10000|1),'bus-l0':(p1,0x10000|1),'bus-target':(p0,0x10000|flags)}
+    if fault in changes: put(*changes[fault])
+    ctx=0x1000|0xabc
+    if fault=='bus-l2': ctx=0x10000|0xabc
+    return image,va,ctx
+
+def main():
+    parser=argparse.ArgumentParser()
+    parser.add_argument('--bsc',default='/tmp/cosmicc-l21-bsc/bin/bsc')
+    parser.add_argument('--verilator')
+    parser.add_argument('--only',default='')
+    a=parser.parse_args();bsc=Path(a.bsc).resolve()
+    build=ROOT/'build/translation-diff';build.mkdir(parents=True,exist_ok=True)
+    env=os.environ.copy();env['PATH']=str(bsc.parent)+os.pathsep+env.get('PATH','');env['BLUESPECDIR']=str(bsc.parent.parent/'lib')
+    search='+: '+':'.join(str(ROOT/p) for p in ('rtl','rtl/common','rtl/mmu','sim')).strip()
+    search=search.replace('+: ','+:')
+    top='mkTbLightingMmuTranslationDiff';source=ROOT/'tests/bsv/TbLightingMmuTranslationDiff.bsv'
+    run([bsc,'-u','-sim','-g',top,'-bdir',build,'-simdir',build,'-p',search,source],cwd=ROOT,env=env)
+    exe=build/'runner'
+    run([bsc,'-sim','-e',top,'-o',exe,'-bdir',build,'-simdir',build,'-p',search],cwd=ROOT,env=env)
+    vexe=None
+    if a.verilator:
+        vdir=build/'verilog';vdir.mkdir(exist_ok=True)
