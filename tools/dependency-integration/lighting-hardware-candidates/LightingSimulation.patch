diff --git a/src/hardware_cpu_board.rs b/src/hardware_cpu_board.rs
new file mode 100644
index 0000000..397ce91
--- /dev/null
+++ b/src/hardware_cpu_board.rs
@@ -0,0 +1,171 @@
+//! Opaque process boundary for the production Lighting CPU/MMU/module RTL.
+//! Rust transports pins and snapshots; instruction execution stays in Bluespec.
+use crate::board_machine::CpuBoardFpga;
+use crate::isa::cpu_board::{
+    LightingBusInputs, LightingBusMasterDrive, LightingBusPayload, LightingModuleInterrupts,
+    SoftwareCpuBoardSnapshot,
+};
+use std::io::{BufRead, BufReader, Write};
+use std::process::{Child, ChildStdin, Command, Stdio};
+use std::sync::{mpsc, Arc, Mutex};
+use std::time::Duration;
+
+#[derive(Clone)]
+pub struct HardwareCpuBoardControl(Arc<Mutex<SoftwareCpuBoardSnapshot>>);
+impl HardwareCpuBoardControl {
+    pub fn snapshot(&self) -> SoftwareCpuBoardSnapshot {
+        self.0
+            .lock()
+            .expect("hardware CPU snapshot poisoned")
+            .clone()
+    }
+}
+pub struct HardwareCpuBoard {
+    child: Child,
+    stdin: ChildStdin,
+    replies: mpsc::Receiver<String>,
+    drive: LightingBusMasterDrive,
+    state: Arc<Mutex<SoftwareCpuBoardSnapshot>>,
+    return_address: Option<u32>,
+    instruction_limit: usize,
+}
+impl HardwareCpuBoard {
+    pub fn spawn(
+        path: &str,
+        reset_pc: u32,
+        instruction_limit: usize,
+    ) -> Result<(Self, HardwareCpuBoardControl), String> {
+        let mut child = Command::new(path)
+            .stdin(Stdio::piped())
+            .stdout(Stdio::piped())
+            .stderr(Stdio::inherit())
+            .spawn()
+            .map_err(|e| format!("start hardware CPU bridge: {e}"))?;
+        let stdin = child.stdin.take().ok_or("missing hardware CPU stdin")?;
+        let stdout = child.stdout.take().ok_or("missing hardware CPU stdout")?;
+        let (tx, replies) = mpsc::channel();
+        std::thread::spawn(move || {
+            for line in BufReader::new(stdout).lines().map_while(Result::ok) {
+                if tx.send(line).is_err() {
+                    break;
+                }
+            }
+        });
+        let state = Arc::new(Mutex::new(SoftwareCpuBoardSnapshot::default()));
+        let control = HardwareCpuBoardControl(state.clone());
+        let mut board = Self {
+            child,
+            stdin,
+            replies,
+            drive: LightingBusMasterDrive::default(),
+            state,
+            return_address: None,
+            instruction_limit,
+        };
+        board.exchange(b'S', 0, reset_pc)?;
+        Ok((board, control))
+    }
+    pub fn stop_at_return_boundary(mut self, address: u32) -> Self {
+        self.return_address = Some(address);
+        self
+    }
+    fn exchange(&mut self, opcode: u8, flags: u8, value: u32) -> Result<(), String> {
+        let mut packet = [0u8; 6];
+        packet[0] = opcode;
+        packet[1] = flags;
+        packet[2..].copy_from_slice(&value.to_le_bytes());
+        self.stdin
+            .write_all(&packet)
+            .and_then(|_| self.stdin.flush())
+            .map_err(|e| format!("hardware CPU input: {e}"))?;
+        let line = self
+            .replies
+            .recv_timeout(Duration::from_secs(30))
+            .map_err(|e| format!("hardware CPU reply: {e}"))?;
+        let f: Vec<_> = line.split('|').collect();
+        if f.len() != 32 || f[0] != "CPU" {
+            return Err(format!("invalid hardware CPU reply: {line}"));
+        }
+        let dec = |i: usize| {
+            f[i].parse::<u64>()
+                .map_err(|e| format!("CPU decimal field {i}: {e}"))
+        };
+        let hex = |i: usize| {
+            u32::from_str_radix(f[i], 16).map_err(|e| format!("CPU hexadecimal field {i}: {e}"))
+        };
+        self.drive = LightingBusMasterDrive {
+            bus_request: dec(1)? != 0,
+            request: dec(2)? != 0,
+            payload: LightingBusPayload {access_kind: dec(31)? as u8, 
+                addr: hex(3)?,
+                write_data: hex(4)?,
+                byte_enable: hex(5)? as u8,
+                write: dec(6)? != 0,
+                validate: dec(7)? != 0,
+            },
+        };
+        let mut state = self
+            .state
+            .lock()
+            .map_err(|_| "hardware CPU snapshot poisoned")?;
+        state.completed_instructions = dec(8)? as usize;
+        state.pc = hex(9)?;
+        state.cause = hex(10)?;
+        state.epc = hex(11)?;
+        state.badaddr = hex(12)?;
+        if dec(13)? == 0 {
+            state.failure = Some(format!("hardware CPU halted: diagnostic {}", dec(14)?));
+        }
+        for i in 0..16 {
+            state.registers[i] = hex(15 + i)?;
+        }
+        if self.return_address == Some(state.pc) && state.completed_instructions > 0 {
+            state.stopped = Some("return boundary".into());
+            self.drive = LightingBusMasterDrive::default();
+        }
+        Ok(())
+    }
+}
+impl CpuBoardFpga for HardwareCpuBoard {
+    fn drive(&mut self) -> LightingBusMasterDrive {
+        self.drive
+    }
+    fn finish_cycle(
+        &mut self,
+        inputs: LightingBusInputs,
+        interrupts: LightingModuleInterrupts,
+    ) -> Result<(), String> {
+        let state = self
+            .state
+            .lock()
+            .map_err(|_| "hardware CPU snapshot poisoned")?
+            .clone();
+        if state.stopped.is_some() {
+            return Ok(());
+        }
+        if let Some(f) = state.failure {
+            return Err(f);
+        }
+        if state.completed_instructions >= self.instruction_limit {
+            return Err("hardware CPU instruction limit".into());
+        }
+        let flags = (inputs.bus_grant as u8)
+            | ((inputs.ready as u8) << 1)
+            | ((inputs.error as u8) << 2)
+            | ((interrupts.plio_irq as u8) << 3)
+            | ((interrupts.timer_irq as u8) << 4)
+            | ((interrupts.machine_fault as u8) << 5);
+        self.exchange(b'C', flags, inputs.read_data)
+    }
+    fn diagnostic(&self) -> String {
+        format!("hardware CPU {:?}", self.state.lock().ok())
+    }
+}
+impl Drop for HardwareCpuBoard {
+    fn drop(&mut self) {
+        let _ = self.stdin.write_all(b"Q");
+        let _ = self.stdin.flush();
+        let _ = self.child.kill();
+        let _ = self.child.wait();
+    }
+}
