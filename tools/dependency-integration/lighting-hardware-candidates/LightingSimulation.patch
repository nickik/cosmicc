+++ b/tests/hardware_cpu_board.rs
@@ -0,0 +1,340 @@
+use lighting_simulation::board_machine::{BoardMemoryBackend, InMemoryBoardBackend};
+use lighting_simulation::mainboard_fpga_multislot_peer::MainboardBackendRequest;
+use lighting_simulation::native_board_call::{run_native_board_call, NativeBoardCall};
+
+#[test]
+fn real_mainboard_preserves_access_class_and_rejects_mmio_before_target_access() {
+    use lighting_simulation::isa::cpu_board::{LightingBusMasterDrive, LightingBusPayload};
+    use lighting_simulation::mainboard_fpga_multislot_peer::{
+        MainboardBackendResponse, MainboardCycleDrive, MainboardFpgaMultiSlotPeer,
+    };
+    let Ok(path) = std::env::var("LIGHTING_MAINBOARD_M6_MULTISLOT_BRIDGE") else {
+        eprintln!("SKIP live qualified access: bridge missing");
+        return;
+    };
+    for (kind, address, lanes, write, validate, reaches_backend, faults) in [
+        (1, 60, 3, false, false, true, false),
+        (1, 60, 12, false, false, true, false),
+        (2, 60, 15, false, false, true, false),
+        (2, 64, 15, false, false, true, true),
+        (2, 0xffff0000, 15, false, false, true, true),
+        (1, 60, 15, false, false, false, true),
+        (2, 60, 3, false, false, false, true),
+        (1, 0xffe00000, 3, false, false, false, true),
+        (2, 0xffe81000, 15, false, false, false, true),
+        (1, 60, 3, true, false, false, true),
+        (2, 60, 15, false, true, false, true),
+        (3, 60, 15, false, false, false, true),
+    ] {
+        let mut peer = MainboardFpgaMultiSlotPeer::spawn(&path).unwrap();
+        let mut backend = InMemoryBoardBackend::new(64);
+        backend.host_write_word(60, 0x12345678).unwrap();
+        let mut request = false;
+        let mut response = None;
+        let mut accesses = 0;
+        let mut completed = false;
+        for _ in 0..128 {
+            let result = peer.cycle_with(MainboardCycleDrive {
+                cpu: LightingBusMasterDrive {
+                    bus_request: true, request,
+                    payload: LightingBusPayload {
+                        access_kind: kind, addr: address, write_data: 1,
+                        byte_enable: lanes, write, validate,
+                    },
+                },
+                backend_request_ready: true, backend_response: response,
+                ..Default::default()
+            }).unwrap();
+            if result.backend_response_ready { response = None; }
+            if let Some(req) = result.backend_request {
+                assert_eq!(req.access_kind, kind);
+                assert!(!req.validate && !req.write);
+                accesses += 1;
+                response = Some(if backend.qualified_read_allowed(req) {
+                    backend.access(req)
+                } else { MainboardBackendResponse { fault: true, read_data: None } });
+            }
+            assert!(result.slots.iter().all(|s| !s.selected && !s.address_strobe && !s.data_strobe));
+            if result.cpu.ready || result.cpu.error {
+                assert_eq!(result.cpu.error, faults, "kind={kind} address={address:08x}");
+                completed = true;
+                break;
+            }
+            if result.cpu.bus_grant { request = true; }
+        }
+        assert!(completed, "qualified request did not complete");
+        assert_eq!(accesses, usize::from(reaches_backend));
+        assert_eq!(backend.host_read_word(60).unwrap(), 0x12345678);
+    }
+}
+
+#[test]
+fn normal_validation_is_side_effect_free_and_bounded() {
+    let mut backend = InMemoryBoardBackend::new(64);
+    backend.host_write_word(60, 0xdeadbeef).unwrap();
+    for write in [false, true] {
+        let request = MainboardBackendRequest {
+            access_kind: 0,
+            validate: true,
+            write,
+            address: 60,
+            byte_enable: 15,
+            ..Default::default()
+        };
+        assert!(backend.validate(request));
+        assert_eq!(backend.host_read_word(60).unwrap(), 0xdeadbeef);
+        assert!(!backend.validate(MainboardBackendRequest {
+            address: 64,
+            ..request
+        }));
+        assert!(!backend.validate(MainboardBackendRequest {
+            address: 61,
+            ..request
+        }));
+        assert!(!backend.validate(MainboardBackendRequest {
+            byte_enable: 3,
+            ..request
+        }));
+        assert!(!backend.validate(MainboardBackendRequest {
+            address: 0xffff_fffc,
+            ..request
+        }));
+    }
+}
+
+#[test]
+fn production_cpu_executes_updating_and_grouped_transfers_through_real_mainboard() {
+    let Ok(mainboard) = std::env::var("LIGHTING_MAINBOARD_M6_MULTISLOT_BRIDGE") else {
+        eprintln!("SKIP live RTL: mainboard bridge missing");
+        return;
+    };
+    if std::env::var("LIGHTING_CPU_BOARD_BRIDGE").is_err() {
+        eprintln!("SKIP live RTL: CPU bridge missing");
+        return;
+    }
+    // Store r1/r2 as a pair; load them into r3/r4; exercise postincrement and
+    // predecrement scalars, then return through the initial architectural LR.
+    let words: [u16; 8] = [
+        0x8152, 0x8350, 0x775c, 0x785e, 0x725f, 0x7854, 0x0134, 0xc0e0,
+    ];
+    let code: Vec<_> = words.iter().flat_map(|w| w.to_le_bytes()).collect();
+    let mut registers = [0; 16];
+    registers[1] = 19;
+    registers[2] = 23;
+    registers[5] = 0x4000;
+    registers[13] = 0x80000;
+    registers[14] = 0x80;
+    let result = run_native_board_call(
+        &mainboard,
+        &NativeBoardCall {
+            code: &code,
+            entry: 0x1000,
+            return_address: 0x80,
+            registers,
+            instruction_limit: 32,
+            cycle_limit: 20000,
+        },
+    )
+    .unwrap();
+    assert_eq!(result.state.registers[1], 42);
+    assert_eq!(result.state.registers[3], 19);
+    assert_eq!(result.state.registers[4], 23);
+    assert_eq!(result.state.registers[7], 19);
+    assert_eq!(result.state.registers[8], 23);
+    assert_eq!(result.state.registers[5], 0x3ffc);
+    assert_eq!(result.state.completed_instructions, 8);
+    assert_eq!(result.minimum_sp, 0x80000);
+}
+
+#[test]
+fn real_mainboard_validation_rejects_mmio_and_bad_shapes_without_target_access() {
+    use lighting_simulation::isa::cpu_board::{LightingBusMasterDrive, LightingBusPayload};
+    use lighting_simulation::mainboard_fpga_multislot_peer::{
+        MainboardBackendResponse, MainboardCycleDrive, MainboardFpgaMultiSlotPeer,
+    };
+    let Ok(path) = std::env::var("LIGHTING_MAINBOARD_M6_MULTISLOT_BRIDGE") else {
+        eprintln!("SKIP live validation: bridge missing");
+        return;
+    };
+    for (address, be, expected_backend, expected_fault) in [
+        (60, 15, true, false),
+        (64, 15, true, true),
+        (61, 15, false, true),
+        (60, 3, false, true),
+        (0xffe00000, 15, false, true),
+        (0xffe10000, 15, false, true),
+    ] {
+        for write in [false, true] {
+            let mut peer = MainboardFpgaMultiSlotPeer::spawn(&path).unwrap();
+            let mut backend = InMemoryBoardBackend::new(64);
+            backend.host_write_word(60, 0xdeadbeef).unwrap();
+            let mut request = false;
+            let mut response = None;
+            let mut validations = 0;
+            let mut completed = false;
+            for _ in 0..128 {
+                let result = peer
+                    .cycle_with(MainboardCycleDrive {
+                        cpu: LightingBusMasterDrive {
+                            bus_request: true,
+                            request,
+                            payload: LightingBusPayload {access_kind: 0, 
+                                addr: address,
+                                write_data: 0x12345678,
+                                byte_enable: be,
+                                write,
+                                validate: true,
+                            },
+                        },
+                        backend_request_ready: true,
+                        backend_response: response,
+                        ..Default::default()
+                    })
+                    .unwrap();
+                if result.backend_response_ready {
+                    response = None;
+                }
+                if let Some(req) = result.backend_request {
+                    assert!(req.validate);
+                    assert_eq!(req.write, write);
+                    validations += 1;
+                    let valid = backend.validate(req);
+                    response = Some(MainboardBackendResponse {
+                        fault: !valid,
+                        read_data: (valid && !write).then_some(0),
+                    });
+                }
+                assert!(result
+                    .slots
+                    .iter()
+                    .all(|s| !s.selected && !s.address_strobe && !s.data_strobe));
+                if result.cpu.ready || result.cpu.error {
+                    assert_eq!(
+                        result.cpu.error, expected_fault,
+                        "addr={address:08x} write={write}"
+                    );
+                    completed = true;
+                    break;
+                }
+                if result.cpu.bus_grant {
+                    request = true;
+                }
+            }
+            assert!(completed, "validation did not complete {address:08x}");
+            assert_eq!(validations, usize::from(expected_backend));
+            assert_eq!(backend.host_read_word(60).unwrap(), 0xdeadbeef);
+        }
+    }
+}
+
+#[test]
+fn compiled_forge_workload_returns_through_production_cpu_and_mainboard() {
+    let (Ok(mainboard), Ok(payload)) = (
+        std::env::var("LIGHTING_MAINBOARD_M6_MULTISLOT_BRIDGE"),
+        std::env::var("LIGHTING_COMPILED_BOARD_WORKLOAD"),
+    ) else {
+        eprintln!("SKIP compiled RTL: bridges/payload missing");
+        return;
+    };
+    let code = std::fs::read(payload).unwrap();
+    let mut registers = [0; 16];
+    registers[13] = 0x80000;
+    registers[14] = 0x80;
+    let result = run_native_board_call(
+        &mainboard,
+        &NativeBoardCall {
+            code: &code,
+            entry: 0x1000,
+            return_address: 0x80,
+            registers,
+            instruction_limit: 1000,
+            cycle_limit: 30000,
+        },
+    )
+    .unwrap();
+    assert_eq!(result.state.registers[1], 55);
+    assert_eq!(result.state.registers[13], 0x80000);
+    assert_eq!(result.state.cause, 0);
+    assert!(result.backend_transactions > 0);
+}
+
+#[test]
+fn translated_execution_matches_rust_through_real_cpu_and_mainboard() {
+    use lighting_simulation::board_machine::LightingBoardMachine;
+    use lighting_simulation::hardware_cpu_board::HardwareCpuBoard;
+    use lighting_simulation::isa::bus::LightingBus;
+    use lighting_simulation::isa::privilege::PrivilegedCpu;
+    let (Ok(mainboard), Ok(cpu_bridge), Ok(fixtures)) = (
+        std::env::var("LIGHTING_MAINBOARD_M6_MULTISLOT_BRIDGE"),
+        std::env::var("LIGHTING_CPU_BOARD_BRIDGE"),
+        std::env::var("LIGHTING_TRANSLATED_BOARD_FIXTURES"),
+    ) else {
+        eprintln!("SKIP translated real RTL: bridges/fixtures missing");
+        return;
+    };
+    for name in [
+        "updating-c-basic",
+        "updating-d-basic",
+        "updating-e-basic",
+        "updating-f-basic",
+        "multi-op-2",
+        "multi-op-8",
+    ] {
+        let dir = std::path::Path::new(&fixtures).join(name);
+        let bytes = std::fs::read(dir.join("memory.bin")).unwrap();
+        let config: Vec<_> = std::fs::read_to_string(dir.join("config.hex"))
+            .unwrap()
+            .lines()
+            .map(|s| u32::from_str_radix(s, 16).unwrap())
+            .collect();
+        let mut machine = LightingBoardMachine::spawn(&mainboard).unwrap();
+        for (i, word) in bytes.chunks_exact(4).enumerate() {
+            machine
+                .load_word(i as u32 * 4, u32::from_le_bytes(word.try_into().unwrap()))
+                .unwrap();
+        }
+        let mut bus = LightingBus::new(1024 * 1024, &[]).unwrap();
+        bus.ram_mut()[..bytes.len()].copy_from_slice(&bytes);
+        let mut reference = PrivilegedCpu::new_sia32_p(&[], 4, false, 1000, 0xfffff000).unwrap();
+        reference.core_mut().write_reg(13,0);
+        let (board, control) = HardwareCpuBoard::spawn(&cpu_bridge, 0, 1000).unwrap();
+        machine
+            .attach_cpu_board(Box::new(board.stop_at_return_boundary(config[2] + 2)))
+            .unwrap();
+        let mut retired = 0;
+        let mut completed = false;
+        for _ in 0..30000 {
+            machine.cycle().unwrap();
+            let state = control.snapshot();
+            if state.completed_instructions != retired {
+                while retired < state.completed_instructions {
+                    assert!(reference.step_on_bus_detailed(&mut bus).unwrap().is_none());
+                    retired += 1;
+                }
+                let regs: [u32; 16] = std::array::from_fn(|r| reference.core().read_reg(r));
+                assert_eq!(state.registers, regs, "{name} retirement {retired}");
+                assert_eq!(state.pc, reference.core().pc(), "{name} retirement PC");
+                assert_eq!(
+                    state.cause,
+                    reference.privileged_state().cause,
+                    "{name} cause"
+                );
+            }
+            if state.stopped.is_some() {
+                completed = true;
+                break;
+            }
+        }
+        assert!(completed, "{name} did not reach checkpoint");
+        for pa in (0x5000..0x6000)
+            .step_by(4)
+            .chain((0x7800..0x8000).step_by(4))
+        {
+            assert_eq!(
+                machine.peek_word(pa).unwrap(),
+                u32::from_le_bytes(bus.ram()[pa as usize..pa as usize + 4].try_into().unwrap()),
+                "{name} memory {pa:08x}"
+            );
+        }
+    }
+}
