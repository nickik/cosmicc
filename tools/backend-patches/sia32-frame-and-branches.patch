         let save_base = frame_layout.fixed_frame_storage_size
@@ -409,6 +416,10 @@ impl ABIMachineSpec for Sia32MachineDeps {
                 ty: I32,
             });
         }
+        out.push(Inst::Mov {
+            dst: regs::writable_frame_reg(),
