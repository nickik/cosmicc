         let env = Sia32MachineDeps::get_machine_env(&flags, isa::CallConv::SystemV);
-        for n in [0, 12, 13, 14] {
+        for n in [0, 12, 13, 14, 15] {
             let preg = regs::preg(n);
             assert!(!env.preferred_regs_by_class[0].contains(preg));
